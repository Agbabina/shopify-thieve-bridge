# Copy to shopify.env and replace every placeholder. Never commit shopify.env.
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_rotated_shopify_client_secret
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,read_webhooks,write_webhooks,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
SHOPIFY_APP_URL=https://your-public-host.example
SHOPIFY_REDIRECT_URL=https://your-public-host.example/api/shopify/callback
SHOPIFY_ADMIN_API_VERSION=2026-07
ADMIN_API_KEY=replace-with-a-long-random-secret
# Replace this development example with your own random 32-byte hex key; never use this example key in production.
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SHOPIFY_DB_PATH=shopify.db
NODE_ENV=development

# Thieve sourcing uses Thieve's official Shopify integration:
# 1. Install/connect Thieve to this Shopify store.
# 2. Import products into this store using Thieve's Shopify app.
# 3. Bridge reads products matching THIEVE_SOURCE_STATUS through Shopify Admin GraphQL (it does not scrape Thieve).
# Use the canonical myshopify.com store URL, not a thieve.co product/catalog URL.
THIEVE_SOURCE_URL=https://your-store.myshopify.com
# Optional: set a tag to import only products carrying this tag. If omitted, all products matching THIEVE_SOURCE_STATUS are inspected.
# THIEVE_SOURCE_TAG=bridge-source
THIEVE_SOURCE_SYNC_INTERVAL_MINUTES=30
THIEVE_SOURCE_STATUS=draft
THIEVE_SOURCE_MAX_PRODUCTS=1000
PRODUCT_MIN_GROSS_MARGIN_PERCENT=20
# Optional verified FX override used by product margin validation (not the dashboard-only rate).
# PRODUCT_FX_MANUAL_FROM=USD
# PRODUCT_FX_MANUAL_TO=NGN
# PRODUCT_FX_MANUAL_RATE=1500

# Optional CLI shop alias mapping:
# CLI_SIMULATED_SHOP=demo
# SHOPIFY_DEFAULT_SHOP_DOMAIN=your-store.myshopify.com
# Or: SHOPIFY_SHOP_ALIASES=demo=your-store.myshopify.com,staging=other-store.myshopify.com

# Optional payment visibility labels (does not activate a payment provider)
SHOPIFY_PAYMENT_PROVIDER=Paystack
SHOPIFY_STORE_CURRENCY=NGN
