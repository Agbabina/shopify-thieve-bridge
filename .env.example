# Copy to shopify.env and replace every placeholder.
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_rotated_shopify_client_secret
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_products,write_products,read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
SHOPIFY_APP_URL=https://your-public-host.example
SHOPIFY_REDIRECT_URL=https://your-public-host.example/api/shopify/callback
ADMIN_API_KEY=replace-with-a-long-random-secret
SHOPIFY_DB_PATH=shopify.db
NODE_ENV=development

# Optional CLI shop alias mapping:
# CLI_SIMULATED_SHOP=demo
# SHOPIFY_DEFAULT_SHOP_DOMAIN=your-store.myshopify.com
# Or: SHOPIFY_SHOP_ALIASES=demo=your-store.myshopify.com,staging=other-store.myshopify.com
